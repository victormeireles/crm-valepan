{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/pipeline-advance",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/zapi-connection-health",
      "schedule": "*/10 * * * *"
    }
  ]
}
